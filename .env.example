# Source FHIR Server Configuration
# Must end with /fhir
SOURCE_URL=https://your-source-fhir-server.com/fhir
# Valid values: KEYCLOAK, BEARER, BASIC, NONE (default)
SOURCE_AUTH_TYPE=
SOURCE_USERNAME=
SOURCE_PASSWORD=
SOURCE_BEARERTOKEN=
SOURCE_DISABLE_SSL=false

# Source Keycloak Configuration
SOURCE_KEYCLOAK_TOKEN_URL=https://your-keycloak-server.com/auth/realms/your-realm/protocol/openid-connect/token
SOURCE_KEYCLOAK_CLIENT_ID=your-client-id
SOURCE_KEYCLOAK_CLIENT_SECRET=your-client-secret

# Target FHIR Server Configuration
# Must end with /fhir
TARGET_URL=https://your-target-fhir-server.com/fhir
# Valid values: KEYCLOAK, BEARER, BASIC, NONE (default)
TARGET_AUTH_TYPE=
TARGET_USERNAME=your-username
TARGET_PASSWORD=your-password
TARGET_BEARERTOKEN=
TARGET_DISABLE_SSL=false

# Target Keycloak Configuration
TARGET_KEYCLOAK_TOKEN_URL=
TARGET_KEYCLOAK_CLIENT_ID=
TARGET_KEYCLOAK_CLIENT_SECRET=

# Other Configuration
# Valid values: MII_2025, MII_2026
SOURCE_FORMAT=MII_2025
# Valid values: BBMRI_DE, MIABIS_V3
TARGET_FORMAT=BBMRI_DE
FILE_EXPORT_PATH=
